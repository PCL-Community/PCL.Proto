{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-resizable",
    "os:default",
    "core:window:allow-minimize",
    "core:window:allow-close",
    "dialog:default",
    "log:allow-log",
    "log:default"
  ]
}
