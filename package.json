    "pug": "^3.0.4",
    "sass-embedded": "^1.107.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vite-svg-loader": "^5.1.3",
    "vue-tsc": "^3.3.14"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
