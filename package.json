{
  "name": "@amagicpear/pcl-proto",
  "displayName": "PCL.Proto",
  "author": {
    "name": "AMagicPear",
    "email": "AMagicPear@outlook.com"
  },
  "version": "0.10.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run tauri dev",
    "build": "bun scripts/check-icons.js && bun run tauri build",
    "ui:dev": "vite",
    "ui:build": "bun run check:ui && bun run --parallel type-check ui:build-only",
    "ui:build-only": "vite build",
    "type-check": "vue-tsc --build",
    "format": "bun fmt src/",
    "deploy": "bun run ui:build && gh-pages -d dist",
    "icons": "tauri icon public/PCL.Proto.png",
    "tauri": "tauri",
    "check:ui": "bun test --isolate --max-concurrency=1 tests/ui/*.test.mjs"
  },
  "dependencies": {
    "@lucide/vue": "^1.70.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "~2.8.4",
    "@tauri-apps/plugin-log": "^2.10.1",
    "@tauri-apps/plugin-os": "~2.4.0",
    "@vueuse/router": "^15.0.0",
    "dompurify": "^3.4.17",
    "esbuild": "^0.28.2",
    "marked": "^18.1.3",
    "motion-v": "^2.11.1",
    "pinia": "^4.1.0",
    "skinview3d": "^3.4.2",
    "vue": "^3.5.45",
    "vue-router": "^5.4.0",
    "xml-js": "^1.6.11"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@tsconfig/node22": "^22.0.6",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "@vue/language-plugin-pug": "^3.3.14",
    "@vue/tsconfig": "^0.9.1",
    "gh-pages": "^6.3.0",
    "pug": "^3.0.4",
    "sass-embedded": "^1.108.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.6",
    "vite-svg-loader": "^5.1.3",
    "vue-tsc": "^3.3.14"
  },
  "trustedDependencies": [
    "@parcel/watcher",
    "esbuild"
  ],
  "packageManager": "bun@1.4.4"
}
