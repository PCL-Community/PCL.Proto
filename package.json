  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/check-icons.js && tauri dev",
    "build": "node scripts/check-icons.js && tauri build",
    "ui:dev": "vite",
    "ui:build": "pnpm check:ui && run-p type-check \"ui:build-only {@}\" --",
    "ui:build-only": "vite build",
    "type-check": "vue-tsc --build",
    "format": "prettier --write src/",
    "deploy": "pnpm ui:build && gh-pages -d dist",
    "tauri": "tauri",
    "check:ui": "node --test --test-concurrency=1 tests/ui/*.test.mjs"
  },
  "dependencies": {
    "@lucide/vue": "^1.65.0",
