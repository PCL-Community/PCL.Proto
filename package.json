    "@tauri-apps/plugin-os": "~2.4.0",
    "@vueuse/router": "^15.0.0",
    "esbuild": "^0.28.2",
    "marked": "^18.1.2",
    "motion-v": "^2.9.0",
    "pinia": "^4.1.0",
    "skinview3d": "^3.4.2",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "xml-js": "^1.6.11"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@tsconfig/node22": "^22.0.6",
